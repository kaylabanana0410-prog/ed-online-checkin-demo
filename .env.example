# Copy to .env and export, or set in your shell. Demo defaults shown.
DATABASE_URL=sqlite:///./checkin.db
RETENTION_DAYS=30
MOCK_AI_MODE=normal   # normal | unavailable | uncertain (to test the safe fallback)
# RULES_PATH=/path/to/hospital-approved/warning_signs.json
OCR_BACKEND=mock          # mock | tesseract
MOCK_OCR_MODE=normal      # normal | blurry | failed (to test the manual fallback)
MAX_UPLOAD_BYTES=5000000
SESSION_HOURS=8
COOKIE_SECURE=false       # true when served over HTTPS
DESTINATIONS="Main waiting area (demo placeholder);Staff will direct you (demo placeholder)"
RATE_LIMIT_ENABLED=true
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
DEBUG_DOCS=false
